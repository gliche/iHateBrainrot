local function SmartDeposit()
	local Multiplier = game:GetService("ReplicatedStorage").Values.EggMultiplier
	if Multiplier.Value > 1 and not globalenv.DepositDebounce then
		globalenv.DepositDebounce = true
		RemoteFunction:InvokeServer("Deposit Eggs")
		task.spawn(function()
			task.wait(5)
			globalenv.DepositDebounce = false
		end)	
	end
end

local function GetDoubleEggs()
	local function DoneOrNot()
		local Cooldown = workspace.Obby.ClaimReward.Button.UI.Cooldown.Text
		if Cooldown == "Claim x2 Eggs!" then
			return true
		else
			return false
		end
	end

	if DoneOrNot() then
		local ClaimRewardPart = workspace.Obby.ClaimReward.Hitbox
		firetouchinterest(ClaimRewardPart, LocalPlayer.Character.HumanoidRootPart, 0)
		firetouchinterest(ClaimRewardPart, LocalPlayer.Character.HumanoidRootPart, 1)
	end
end

local RunService = game:GetService("RunService")
if false then
	RunService:Set3dRenderingEnabled(false)
else
	RunService:Set3dRenderingEnabled(true)
end

globalenv.MainLoop = task.spawn(function()
	while task.wait(globalenv.Rate) do
		RemoteFunction:InvokeServer("Collect Cash")

		if globalenv.AutoDeposit then
			if globalenv.SmartDeposit then
				SmartDeposit()
			end
			RemoteFunction:InvokeServer("Deposit Eggs")
		end

		if globalenv.AutoBuyChickens then
			RemoteFunction:InvokeServer("Buy Chickens", globalenv.AutoBuyChickensAmount)
		end

		if globalenv.AutoMerge then
			RemoteFunction:InvokeServer("Merge Chickens")
		end

		if globalenv.GetDoubleEggsDone then
			GetDoubleEggs()
		end
		if globalenv.AutoCollectEggs then
			CollectEggsFunction:FireServer("Collect All Eggs")
			for i, v in ipairs(EggsFolder:GetChildren()) do
				CollectEggsFunction:FireServer("Collect Egg", v.Name)
				v:Destroy()
			end
		end
	end
end)

globalenv.ScriptLoadedExists = function()
	task.cancel(globalenv.MainLoop)
	NeverLose:Unload()
end

